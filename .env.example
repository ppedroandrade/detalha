# demo | local | production. Local: desenvolvimento persistente sem serviços externos.
DETALHA_MODE=local
APP_URL=http://localhost:3000
# Diretório privado; nunca dentro de public/. Um único processo local por diretório.
LOCAL_DATA_DIR=.detalha
# Production: usuário SQL limitado com SET ROLE detalha_app (ver README).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=project-documents
MAX_FILE_BYTES=20971520
MAX_ORGANIZATION_BYTES=536870912
MAX_PROJECT_FILES=100
SIGNED_URL_TTL_SECONDS=60
# mock é permitido apenas no modo local. Real: contrato preparado, ainda indisponível.
DOCUMENT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
OPENAI_REVIEW_MODEL=
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=120
MAX_PROCESSING_ATTEMPTS=3
MAX_ORGANIZATION_RUNS_PER_DAY=30
# Retenção: arquivamento preserva histórico; expurgo deve ser configurado antes de produção.
ARCHIVED_RETENTION_DAYS=90
